# Scratch space: the folder is kept, its contents are never committed
temp/*
!temp/.gitkeep

# Python virtual environments
.venv/
venv/
env/

# Python build / cache artefacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / Vite
node_modules/
dist/

# Claude Code local (per-user) settings; shared skills stay tracked
.claude/settings.local.json

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp
